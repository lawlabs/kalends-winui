<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Kalends</RootNamespace>
    <AssemblyName>Kalends.WinUI</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultLanguage>en-US</DefaultLanguage>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>Kalends.WinUI</PackageId>
    <Version>0.2.1</Version>
    <Authors>LawLabs</Authors>
    <Company>LawLabs (ООО «Лаборатория юридических исследований»)</Company>
    <Description>WinUI 3 calendar views with event layout and drag-and-drop. The host owns storage and editing.</Description>
    <PackageReleaseNotes>Correct compact event drag previews: preserve card size and pointer anchor, outline the target date, and keep the grabbed segment of multi-day events anchored to the drop date.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/lawlabs/kalends-winui</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lawlabs/kalends-winui</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>winui;winui3;windows-app-sdk;dotnet;calendar</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 LawLabs (ООО «Лаборатория юридических исследований»)</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
